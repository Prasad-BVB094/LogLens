```gitignore
# Build directories & CMake output
build/
build-*/
bin/
lib/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
Testing/
*.ninja
.ninja_*
compile_commands.json
.cache/

# Executables & binaries
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
loglens

# Databases & SQLite files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Logs (keep sample and test fixtures)
*.log
!data/*.log
!tests/fixtures/*.log

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Node / Web artifacts
node_modules/
dist/
coverage/

# Environment files
.env*
.env.example

# Private project documentation
/docs/

# AI Studio metadata
/metadata.json

# Unneeded frontend/package configuration
/package.json
